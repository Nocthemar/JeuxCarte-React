# Modèle de configuration : copie ce fichier en « .env.local » et remplis les valeurs.
# Supabase > Project Settings > API Keys : la clé « publishable » (sb_publishable_…) ou « anon ».
# JAMAIS la clé secrète (sb_secret_… / service_role) ici : tout ce qui commence par VITE_ est visible dans le navigateur.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
